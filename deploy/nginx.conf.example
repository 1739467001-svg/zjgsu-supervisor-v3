# 替换学校确认域名及证书路径；在http块加载。不是可直接启用的生产配置。
limit_req_zone $binary_remote_addr zone=zjgsu_login:10m rate=2r/s;
server {
    listen 80;
    server_name SUPERVISOR_DOMAIN;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name SUPERVISOR_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/SUPERVISOR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/SUPERVISOR_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 21m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    location ~ ^/api/trpc/.*auth\.loginByEmployeeId {
        limit_req zone=zjgsu_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
